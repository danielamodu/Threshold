{
  "name": "@threshold/ingestion",
  "version": "0.0.0",
  "private": true,
  "description": "Ingestion Layer (§2) — telemetry adapter, deterministic simulator, event normalisation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@threshold/types": "*"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
