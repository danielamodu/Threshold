{
  "name": "@threshold/output",
  "version": "0.0.0",
  "private": true,
  "description": "Output / Integration Layer (§2, §6 Phase 4) — compliance PDF, claim draft, mocked reroute, webhook contract",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
