{
  "name": "@threshold/motive-client",
  "version": "0.0.0",
  "private": true,
  "description": "Motive (formerly KeepTruckin) Public API client — vehicle location history (§11 Phase 8)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "verify": "tsx scripts/verify.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
