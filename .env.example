# Threshold — environment template.
# Copy to .env and fill in. NEVER commit .env. The API key is never logged by this codebase.

# ---- FortyGuard Enterprise API (§8) ----
# Auth is a plain API key sent in the `api-key` header. No OAuth, no token exchange.
FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.com/v1

# Poll tuning for the async submit/poll job cycle.
# The API returns 404 transiently right after submit; the client tolerates that.
FORTYGUARD_POLL_INTERVAL_MS=5000
FORTYGUARD_POLL_TIMEOUT_MS=600000
FORTYGUARD_REQUEST_TIMEOUT_MS=30000

# ---- Neon Postgres (§2 Audit Layer, §4) ----
# Serverless Postgres over a plain connection string. Grab it from the Neon
# console → Connection Details. Keep `?sslmode=require` — Neon requires TLS and
# the migration runner enables it based on that flag.
#
#   postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
#
# The POOLED string (host contains `-pooler`) is the right default for the API
# server. It also applies these migrations fine — verified — because each one
# runs as a single transaction, which pgbouncer's transaction mode handles.
# Switch to the DIRECT string if a future migration needs session state to
# survive across statements (advisory locks, SET LOCAL, CREATE DATABASE).
NEON_DATABASE_URL=

# Optional local override for verification against a plain Postgres.
# The migration runner falls back to this when NEON_DATABASE_URL is unset.
DATABASE_URL=

# ---- API server ----
PORT=8080
NODE_ENV=development
