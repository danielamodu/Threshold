# Threshold — environment template.
# Copy to .env and fill in. NEVER commit .env. The API key is never logged by this codebase.

# ---- FortyGuard Enterprise API (§8) ----
# Auth is a plain API key sent in the `api-key` header. No OAuth, no token exchange.
FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.com/v1

# Poll tuning for the async submit/poll job cycle.
# The API returns 404 transiently right after submit; the client tolerates that.
FORTYGUARD_POLL_INTERVAL_MS=5000
FORTYGUARD_POLL_TIMEOUT_MS=600000
FORTYGUARD_REQUEST_TIMEOUT_MS=30000

# ---- Supabase / Postgres (§2 Audit Layer) ----
# `supabase start` prints these for local dev.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- API server ----
PORT=8080
NODE_ENV=development
