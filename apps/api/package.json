{
  "name": "@threshold/api",
  "version": "0.0.0",
  "private": true,
  "description": "Threshold backend — Fastify. Phase 0: skeleton only.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@threshold/fortyguard-client": "*",
    "@threshold/types": "*",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
