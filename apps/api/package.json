{
  "name": "@threshold/api",
  "version": "0.0.0",
  "private": true,
  "description": "Threshold backend — Fastify. Phase 0: skeleton only.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.check.json",
    "simulate": "tsx scripts/simulate.ts",
    "simulate:real": "tsx scripts/real-ingest.ts",
    "verify:org-scoped": "tsx scripts/verify-org-scoped.ts",
    "generate:real-pdfs": "tsx scripts/generate-real-pdfs.ts",
    "revalidate-cache": "tsx scripts/revalidate-cache.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@clerk/backend": "^3.16.10",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.2",
    "@threshold/accounts": "*",
    "@threshold/audit": "*",
    "@threshold/decision-layer": "*",
    "@threshold/fortyguard-client": "*",
    "@threshold/ingestion": "*",
    "@threshold/output": "*",
    "@threshold/pipeline": "*",
    "@threshold/risk-engine": "*",
    "@threshold/types": "*",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
